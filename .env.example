# Copy this file to .env and adjust the values.
# NEVER commit the real .env file (it is ignored by .gitignore).

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# --- PostgreSQL (read by backend/app/config.py) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=coldchain
DB_USER=coldchain
DB_PASSWORD=change-me
# Optional: full URL (overrides DB_* values when set)
# DATABASE_URL=postgresql://user:password@localhost:5432/coldchain

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- MinIO (S3-compatible storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=coldchain

# --- MQTT (Mosquitto) ---
MQTT_ENABLED=true
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=coldchain
# Leave both empty for an anonymous local broker
MQTT_USERNAME=
MQTT_PASSWORD=

# --- OpenAI (AI chatbot - implemented in a later step) ---
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini